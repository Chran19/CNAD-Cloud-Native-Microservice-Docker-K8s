# Ignore dependencies (re-installed inside the image)
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore Git version control files
.git
.gitignore

# Ignore documentation and evidence screenshots
screenshots
*.md
README.md

# Ignore IDE and editor configurations
.vscode
.idea
*.swp
*.swo

# Ignore OS artifacts
.DS_Store
Thumbs.db

# Ignore environment overrides
.env
.env.*

